FLOWAI_HTTP_ADDR=127.0.0.1:3001
FLOWAI_SANDBOX_GRPC_ADDR=127.0.0.1:50052
FLOWAI_GRPC_TOKEN=replace-with-a-random-service-token
FLOWAI_DATABASE_URL=postgresql+psycopg://flowai_ai:replace-me@127.0.0.1:5432/flowai_studio?sslmode=disable
FLOWAI_MIGRATION_DATABASE_URL=postgresql+psycopg://flowai_ai_migrator:replace-me@127.0.0.1:5432/flowai_studio?sslmode=disable
FLOWAI_REDIS_URL=redis://127.0.0.1:6379/0
FLOWAI_JWT_SECRET=replace-with-a-random-jwt-secret
FLOWAI_JWT_EXPIRATION=168h
FLOWAI_API_KEY_HMAC_SECRET=replace-with-a-random-hmac-secret
FLOWAI_FRONTEND_URL=http://127.0.0.1:5173
